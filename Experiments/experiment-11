
#include <stdio.h>
#include <math.h>

int main()
{
    long double keys = 1;
    int i;

    for(i = 1; i <= 25; i++)
    {
        keys = keys * i;
    }

    printf("Possible Playfair keys = 25! = %.0Lf\n", keys);
    printf("Approximate power of 2 = 2^83.68\n");

    printf("\nEffectively unique keys = 25! / 25\n");
    printf("Effectively unique keys = 24! = ");

    keys = 1;

    for(i = 1; i <= 24; i++)
    {
        keys = keys * i;
    }

    printf("%.0Lf\n", keys);

    return 0;
}
