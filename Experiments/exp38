/* EXPERIMENT 38: HILL CIPHER KNOWN PLAINTEXT ATTACK */

#include <stdio.h>

int mod(int x)
{
    return (x % 26 + 26) % 26;
}

int inverse(int x)
{
    int i;

    for(i = 1; i < 26; i++)
    {
        if((x * i) % 26 == 1)
            return i;
    }

    return -1;
}

int main()
{
    int P[2][2], C[2][2], Pinv[2][2], K[2][2];
    int det, invdet, i, j;

    printf("Enter plaintext matrix (2x2):\n");

    for(i = 0; i < 2; i++)
        for(j = 0; j < 2; j++)
            scanf("%d", &P[i][j]);

    printf("Enter ciphertext matrix (2x2):\n");

    for(i = 0; i < 2; i++)
        for(j = 0; j < 2; j++)
            scanf("%d", &C[i][j]);

    det = mod(P[0][0] * P[1][1] -
              P[0][1] * P[1][0]);

    invdet = inverse(det);

    if(invdet == -1)
    {
        printf("Plaintext matrix is not invertible modulo 26.");
        return 0;
    }

    Pinv[0][0] = mod(invdet * P[1][1]);
    Pinv[0][1] = mod(-invdet * P[0][1]);
    Pinv[1][0] = mod(-invdet * P[1][0]);
    Pinv[1][1] = mod(invdet * P[0][0]);

    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
        {
            K[i][j] = mod(C[i][0] * Pinv[0][j] +
                          C[i][1] * Pinv[1][j]);
        }
    }

    printf("\nRecovered Hill Cipher Key:\n");

    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
            printf("%d ", K[i][j]);

        printf("\n");
    }

    return 0;
}
