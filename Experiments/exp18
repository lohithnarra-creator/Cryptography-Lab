/* EXPERIMENT 18: DES KEY GENERATION USING PC-1 AND LEFT SHIFTS */

#include <stdio.h>
#include <string.h>

int PC1[56] = {
    57,49,41,33,25,17,9,
    1,58,50,42,34,26,18,
    10,2,59,51,43,35,27,
    19,11,3,60,52,44,36,
    63,55,47,39,31,23,15,
    7,62,54,46,38,30,22,
    14,6,61,53,45,37,29,
    21,13,5,28,20,12,4
};

int shifts[16] = {
    1,1,2,2,2,2,2,2,
    1,2,2,2,2,2,2,1
};

int main()
{
    char key[65];
    char permuted[57];
    char C[29], D[29];
    int i, round, j, shift;

    printf("Enter 64-bit DES key (0s and 1s): ");
    scanf("%64s", key);

    if(strlen(key) != 64)
    {
        printf("Invalid key length.\n");
        return 1;
    }

    for(i = 0; i < 64; i++)
    {
        if(key[i] != '0' && key[i] != '1')
        {
            printf("Invalid key. Enter only binary digits.\n");
            return 1;
        }
    }

    for(i = 0; i < 56; i++)
        permuted[i] = key[PC1[i] - 1];

    permuted[56] = '\0';

    for(i = 0; i < 28; i++)
    {
        C[i] = permuted[i];
        D[i] = permuted[i + 28];
    }

    C[28] = '\0';
    D[28] = '\0';

    printf("\nAfter PC-1:\n");
    printf("C0 = %s\n", C);
    printf("D0 = %s\n", D);

    for(round = 0; round < 16; round++)
    {
        for(shift = 0; shift < shifts[round]; shift++)
        {
            char firstC = C[0];
            char firstD = D[0];

            for(j = 0; j < 27; j++)
            {
                C[j] = C[j + 1];
                D[j] = D[j + 1];
            }

            C[27] = firstC;
            D[27] = firstD;
        }

        printf("\nRound %d:\n", round + 1);
        printf("C%d = %s\n", round + 1, C);
        printf("D%d = %s\n", round + 1, D);
    }

    return 0;
}
