/* EXPERIMENT 14: ONE-TIME PAD VIGENERE CIPHER */

#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char plaintext[] = "send more money";
    char ciphertext[100];
    char target[] = "cash not needed";
    int key[] = {9, 0, 1, 7, 23, 15, 21,
                 14, 11, 11, 2, 8, 9};

    int i, j = 0, value;

    printf("Plaintext: %s\n", plaintext);
    printf("Encrypted text: ");

    for(i = 0; plaintext[i] != '\0'; i++)
    {
        if(isalpha(plaintext[i]))
        {
            value = (tolower(plaintext[i]) - 'a' + key[j]) % 26;
            ciphertext[j] = value + 'a';
            printf("%c", ciphertext[j]);
            j++;
        }
        else
        {
            printf("%c", plaintext[i]);
        }
    }

    ciphertext[j] = '\0';

    printf("\n\nCiphertext: %s\n", ciphertext);

    printf("\nKey stream to decrypt the given ciphertext\n");
    printf("into: %s\n", target);

    j = 0;

    for(i = 0; target[i] != '\0'; i++)
    {
        if(isalpha(target[i]))
        {
            value = (tolower(target[i]) - 'a');
            printf("%d ", (value + 26) % 26);
            j++;
        }
    }

    printf("\n");

    return 0;
}
