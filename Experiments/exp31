/* EXPERIMENT 31: CMAC SUBKEY GENERATION */

#include <stdio.h>

void leftShift(unsigned char input[], unsigned char output[], int n)
{
    int i;

    for(i = 0; i < n - 1; i++)
        output[i] = (input[i] << 1) | (input[i + 1] >> 7);

    output[n - 1] = input[n - 1] << 1;
}

int main()
{
    unsigned char L[16], K1[16], K2[16];
    unsigned char Rb = 0x87;
    int i, n;

    printf("Enter block size (64 or 128 bits): ");
    scanf("%d", &n);

    if(n != 64 && n != 128)
    {
        printf("Invalid block size.\n");
        return 1;
    }

    n = n / 8;

    printf("Enter L in hexadecimal (%d bytes): ", n);

    for(i = 0; i < n; i++)
        scanf("%2hhx", &L[i]);

    leftShift(L, K1, n);

    if(L[0] & 0x80)
        K1[n - 1] ^= (n == 8) ? 0x1B : Rb;

    leftShift(K1, K2, n);

    if(K1[0] & 0x80)
        K2[n - 1] ^= (n == 8) ? 0x1B : Rb;

    printf("\nCMAC Subkey K1: ");

    for(i = 0; i < n; i++)
        printf("%02X ", K1[i]);

    printf("\nCMAC Subkey K2: ");

    for(i = 0; i < n; i++)
        printf("%02X ", K2[i]);

    printf("\n");

    return 0;
}
