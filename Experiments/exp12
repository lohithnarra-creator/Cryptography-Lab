#include <stdio.h>
#include <string.h>

int main()
{
    int key[2][2] = {{9, 4}, {5, 7}};
    int inverse[2][2] = {{15, 18}, {17, 11}};
    char text[100];
    int a, b, c, d;
    int i, j, k;
    int x[2], y[2];

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    int len = 0;
    for(i = 0; text[i] != '\0'; i++)
        if(text[i] >= 'a' && text[i] <= 'z')
            text[len++] = text[i];

    if(len % 2 != 0)
        text[len++] = 'x';

    text[len] = '\0';

    printf("\nEncrypted text: ");

    for(i = 0; i < len; i += 2)
    {
        x[0] = text[i] - 'a';
        x[1] = text[i + 1] - 'a';

        for(j = 0; j < 2; j++)
        {
            y[j] = 0;
            for(k = 0; k < 2; k++)
                y[j] += key[j][k] * x[k];

            y[j] %= 26;
        }

        printf("%c%c", y[0] + 'a', y[1] + 'a');
    }

    printf("\n");

    printf("Enter ciphertext to decrypt: ");
    scanf("%s", text);

    printf("Decrypted text: ");

    for(i = 0; text[i] != '\0'; i += 2)
    {
        x[0] = text[i] - 'a';
        x[1] = text[i + 1] - 'a';

        for(j = 0; j < 2; j++)
        {
            y[j] = 0;
            for(k = 0; k < 2; k++)
                y[j] += inverse[j][k] * x[k];

            y[j] %= 26;
        }

        printf("%c%c", y[0] + 'a', y[1] + 'a');
    }

    return 0;
}
